# Google OAuth Configuration
# Get these from Google Cloud Console - OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# For HTML-based OAuth (different secret if needed)
GOOGLE_CLIENT_SECRET_HTML=your_google_client_secret_html_here

# Vite exposes environment variables to the browser with VITE_ prefix
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_vite_google_client_secret_here

# Slack Configuration
# Create an app at https://api.slack.com/apps (redirect URL:
# http://localhost:8080/slack/callback). User-token scopes: channels:history,
# groups:history, im:history, mpim:history, channels:read, users:read, chat:write
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here

# Claude/Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Configuration (for AI email reply generation)
OPENAI_API_KEY=your_openai_api_key_here

# Lakera Guard — prompt injection defense (https://platform.lakera.ai)
LAKERA_GUARD_API_KEY=your_lakera_guard_api_key_here

# Database Configuration
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=your_api_key_here"

# Frontend OAuth Configuration
VITE_APP_BASE_URL=http://localhost:1420
VITE_OAUTH_PAGE=test-oauth.html

# You can also use oauth.html if you prefer:
# VITE_OAUTH_PAGE=oauth.html