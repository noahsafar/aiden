# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail API Configuration
GMAIL_API_KEY=your_gmail_api_key_here

# Database Configuration
DATABASE_URL=sqlite:./prisma/aiden.db

# Frontend OAuth Configuration (for Vite/React)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_APP_BASE_URL=http://localhost:1420
VITE_OAUTH_PAGE=test-oauth.html

# You can also use oauth.html if you prefer:
# VITE_OAUTH_PAGE=oauth.html