// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./aiden.db"
}

model Email {
  id                   String   @id
  gmailId              String   @unique
  threadId             String
  subject              String
  sender               String
  recipients           String   // JSON array
  date                 DateTime
  bodyText             String
  bodyHtml             String?
  snippet              String
  isRead               Boolean  @default(false)
  isStarred            Boolean  @default(false)
  hasAttachments       Boolean  @default(false)
  status               EmailStatus @default(Unhandled)
  category             EmailCategory @default(Normal)
  summary              String?
  keyPoints            String   // JSON array
  requiresReply        Boolean  @default(false)
  aiGeneratedReply     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("emails")
}

model UserStyle {
  userEmail            String   @id
  tone                 String
  formalityScore       Float
  commonPhrases        String   // JSON array
  avgSentenceLength    Float
  avgResponseTimeMinutes Float
  lastUpdated          DateTime @default(now())

  @@map("user_styles")
}

model NotificationHistory {
  id                   String   @id
  emailId              String
  sentAt               DateTime @default(now())
  clickedAt            DateTime?
  actionTaken          String?

  @@map("notification_history")
}

model QueuedEmail {
  id                   String   @id
  gmailId              String
  scheduledFor         DateTime
  recipient            String
  subject              String
  body                 String
  isDraft              Boolean  @default(false)

  @@map("queued_emails")
}

model Settings {
  key                  String   @id
  value                String

  @@map("settings")
}

enum EmailStatus {
  Unhandled
  Reviewed
  Replied
  Archived
  Scheduled
  AutoHandled
}

enum EmailCategory {
  Urgent
  Important
  Normal
  Low
  Spam
  Newsletter
  Notification
}

model Contact {
  id                   String   @id
  emailAddress         String   @unique
  name                 String?
  domain               String?
  firstSeen            DateTime @default(now())
  lastContacted        DateTime?
  totalEmailsReceived  Int      @default(0)
  totalEmailsSent      Int      @default(0)
  totalThreads         Int      @default(0)
  relationshipScore    Float    @default(0)
  category             ContactCategory @default(Other)
  isVIP                Boolean  @default(false)
  lastScoreCalculation DateTime?
  avgResponseTimeMinutes Float?
  lastResponseTime     DateTime?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("contacts")
  @@index([emailAddress])
  @@index([relationshipScore])
  @@index([lastContacted])
}

model EmailInteraction {
  id                   String   @id
  emailId              String
  contactId            String
  direction            InteractionDirection
  timestamp            DateTime
  responseTimeMinutes  Int?
  threadDepth          Int?
  wasInitiator         Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@map("email_interactions")
  @@index([contactId, timestamp])
  @@index([emailId])
}

model ContactNote {
  id                   String   @id
  contactId            String
  content              String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("contact_notes")
  @@index([contactId])
}

enum ContactCategory {
  Colleague
  Client
  Vendor
  Friend
  Family
  Other
}

enum InteractionDirection {
  Incoming
  Outgoing
}
